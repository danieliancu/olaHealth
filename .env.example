# Copy to .env and adjust. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS, e.g. https://olahealth.example
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production defaults are secure. For plain-HTTP local runs with DEBUG=0 set both to 0.
SECURE_SSL_REDIRECT=1
SECURE_COOKIES=1
SECURE_HSTS_SECONDS=2592000
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_X_FORWARDED_FOR=0
LOG_LEVEL=INFO
WEB_PORT=8000

# Accounts and email (dev: compose.dev.yaml points EMAIL_HOST at Mailpit, inbox on :18025)
ACCOUNT_EMAIL_VERIFICATION=mandatory
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=FoodoTrack <no-reply@example.com>

# Backups (service `backup`)
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Monitoring (optional): errors go to Sentry when SENTRY_DSN is set
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
LOG_FORMAT=plain

# --- PostgreSQL ---
POSTGRES_DB=olahealth
POSTGRES_USER=olahealth
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Open Food Facts (read-only) ---
OFF_BASE_URL=https://world.openfoodfacts.org
# OFF asks for "AppName/Version (contact)". Put a real contact address here.
OFF_USER_AGENT=olaHealth/0.1 (contact@example.org)
OFF_CONNECT_TIMEOUT=3
OFF_READ_TIMEOUT=10
OFF_MAX_RETRIES=1
# After an OFF timeout or 5xx, answer "unavailable" at once for this many seconds.
OFF_CIRCUIT_SECONDS=60
OFF_RETRY_AFTER_CAP=5
# OFF documents 15 product reads/min/IP; shared by all web + worker processes.
OFF_RATE_LIMIT_PER_MINUTE=12
OFF_FRESH_TTL_HOURS=168
OFF_NEGATIVE_TTL_MINUTES=30
OFF_LEASE_SECONDS=30
OFF_REFRESH_BATCH=20

# --- Abuse limits (per session; per IP = 3x) ---
RL_LOOKUP_PER_MIN=30
RL_UPLOAD_PER_HOUR=40
RL_SCAN_PHOTO_PER_HOUR=30
RL_CONTRIBUTION_PER_HOUR=10
RL_OCR_RETRY_PER_HOUR=10

# --- Uploads ---
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=40000000
UPLOAD_STORED_MAX_SIDE=3000

# --- OCR worker ---
Q_WORKERS=2
OCR_TIMEOUT_SECONDS=40
OCR_MAX_ATTEMPTS=2
WORKER_MEM_LIMIT=768m

# --- Retention ---
DRAFT_RETENTION_DAYS=30
REJECTED_IMAGE_RETENTION_DAYS=30

# --- Ask Foodo AI ---
# API keys only. Provider, model, daily message limit and monthly budget are set in the
# staff panel (Site settings); AI stays off until enabled there.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
# Alibaba Qwen outside the international region, e.g. https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# Local Ollama (no key), e.g. on the host: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
